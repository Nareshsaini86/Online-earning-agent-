PORT=3000
# Optional AI enhancement. Can incur provider charges; disabled without a key.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# Semicolon-separated RSS feed URLs. Feed contents and availability may vary.
JOB_RSS_FEEDS=https://hnrss.org/jobs

# Optional folder to scan/edit. Defaults to the current working directory.
PROJECT_ROOT=
# Keep loopback-only for local file workspace security. Set HOST only when intentional.
HOST=127.0.0.1
